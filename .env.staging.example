# Staging environment template.
#
# Copy to `.env.staging` on the VPS (chmod 600, outside version control) and
# fill in real values. Every domain below is an EXAMPLE — replace with your
# actual staging domains; nothing in the app or Nginx templates hardcodes
# them. See docs/runbooks/STAGING_DEPLOYMENT.md for the full deploy
# procedure and docs/runbooks/ENVIRONMENT_VARIABLES.md for what each
# variable does and why.
#
# Generate DJANGO_SECRET_KEY and DB/REDIS passwords with:
#   scripts/generate-secrets.sh

# --- Domains ----------------------------------------------------------------
# Consumed by scripts/nginx/install-sites.sh, scripts/nginx/issue-certs.sh,
# and the e2e/staging-smoke suite — the single source of truth for "which
# domain is which service", so ALLOWED_HOSTS/CSRF_TRUSTED_ORIGINS/
# CORS_ALLOWED_ORIGINS/NEXT_PUBLIC_* below should always list the same three
# domains defined here.
BACKEND_DOMAIN=chat-staging.rastisi.ir
OPERATOR_DOMAIN=operator-chat-staging.rastisi.ir
PLATFORM_DOMAIN=platform-chat-staging.rastisi.ir
# Email Certbot registers the certificates under (renewal reminders, not
# used for anything else) — not a real address in this template.
CERTBOT_EMAIL=REPLACE_WITH_A_REAL_ADMIN_EMAIL

# Host-side ports docker-compose.staging.yml publishes to 127.0.0.1 and
# that the Nginx templates above proxy to — change only if something else
# on this VPS already uses one of these (see scripts/staging/preflight.sh).
BACKEND_PORT=8100
OPERATOR_PORT=3100
PLATFORM_PORT=3101
WIDGET_PORT=8180

# Compose project name — pins the named-volume namespace (postgres_data,
# redis_data) so it doesn't depend on the checkout directory's name. Give
# staging and production distinct values if either could ever run on the
# same host (they use this same docker-compose.staging.yml file with
# different env files). Changing this on an existing installation orphans
# the old volumes — see docs/runbooks/STAGING_DEPLOYMENT.md "Compose
# project name" before changing it post-deploy.
COMPOSE_PROJECT_NAME=rastichat-staging

# --- Django ---------------------------------------------------------------
ENVIRONMENT=staging
DEBUG=0
DJANGO_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_scripts_generate-secrets.sh
DJANGO_SETTINGS_MODULE=config.settings

# Comma-separated, no wildcard — settings.py refuses to start without this.
ALLOWED_HOSTS=chat-staging.rastisi.ir,operator-chat-staging.rastisi.ir,platform-chat-staging.rastisi.ir

# Comma-separated, full scheme+host, no trailing slash.
CSRF_TRUSTED_ORIGINS=https://operator-chat-staging.rastisi.ir,https://platform-chat-staging.rastisi.ir
# CORS is a known, explicit allowlist here (never a wildcard): every real
# page that embeds the Widget or calls this API from a browser, i.e. the
# Rastisi site(s) the Widget <script> tag is embedded on, plus both
# dashboards. Add each new Rastisi host domain here as it goes live; there
# is deliberately no dynamic/wildcard fallback for arbitrary unknown
# embedding sites in this phase (see "Known limitations" in
# docs/runbooks/STAGING_DEPLOYMENT.md).
CORS_ALLOWED_ORIGINS=https://operator-chat-staging.rastisi.ir,https://platform-chat-staging.rastisi.ir,https://chat-staging.rastisi.ir,https://REPLACE_WITH_RASTISI_STOREFRONT_DOMAIN

TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO
# Optional: move the admin off the well-known path to cut scanner noise.
# ADMIN_URL=admin/

# --- Database (Postgres, private network only — never expose 5432) -------
DATABASE_URL=postgres://rastichat:REPLACE_WITH_GENERATED_PASSWORD@db:5432/rastichat_db
DB_CONN_MAX_AGE=60

# --- Redis (Channels/WebSocket layer, private network only) --------------
REDIS_URL=redis://redis:6379/0
# If Redis requires auth (recommended): redis://:PASSWORD@redis:6379/0

# --- Media / static --------------------------------------------------------
# In-container paths (used by the Django process itself).
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
# Host paths backing the same data (used by docker-compose.staging.yml's
# bind-mounted volumes AND by the Nginx template that serves /media/ and
# /static/ directly — see deploy/nginx/sites/backend.conf.template).
MEDIA_HOST_PATH=/opt/rastichat/media
STATIC_HOST_PATH=/opt/rastichat/staticfiles
# UID/GID the backend container's non-root `rastichat` user runs as (baked
# into the image at build time via the same-named build args — see
# backend/Dockerfile.prod). scripts/staging/deploy.sh chowns
# MEDIA_HOST_PATH/STATIC_HOST_PATH to this exact UID/GID before every
# deploy, so the container can write uploaded media/collected static files
# into its own bind mounts. Change only if 10001 is already taken on your
# host, and if you do, change it here BEFORE the first deploy (changing it
# later requires re-chowning existing files by hand).
RASTICHAT_UID=10001
RASTICHAT_GID=10001

# --- Upload limits ----------------------------------------------------------
MEDIA_UPLOAD_MAX_IMAGE_BYTES=8388608
MEDIA_UPLOAD_MAX_VOICE_BYTES=15728640
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520

# --- Rate limiting (see docs/runbooks/ENVIRONMENT_VARIABLES.md for what
# each scope protects) -------------------------------------------------------
LOGIN_THROTTLE_RATE=10/min
WIDGET_START_THROTTLE_RATE=20/min
WIDGET_MESSAGE_THROTTLE_RATE=60/min
WIDGET_RATING_THROTTLE_RATE=20/min
KB_FEEDBACK_THROTTLE_RATE=20/min
KB_SEARCH_THROTTLE_RATE=60/min
MACRO_EXECUTION_THROTTLE_RATE=60/min
MEDIA_UPLOAD_THROTTLE_RATE=30/min
WIDGET_WS_MESSAGE_RATE_LIMIT=30
WIDGET_WS_MESSAGE_RATE_WINDOW_SECONDS=60

# --- Security headers -------------------------------------------------------
# HSTS preload is a serious, hard-to-reverse decision (removal from browser
# preload lists takes months) — left off by default even in staging/prod.
# SECURE_HSTS_PRELOAD=0
SECURE_HSTS_SECONDS=31536000

# --- Frontend build-time URLs (baked into the Next.js image at build time —
# see docker/operator-dashboard.Dockerfile / docker/platform-dashboard.Dockerfile
# build args; rebuild the image if these change) ----------------------------
NEXT_PUBLIC_API_BASE_URL=https://chat-staging.rastisi.ir/api/v1
NEXT_PUBLIC_WS_BASE_URL=wss://chat-staging.rastisi.ir/ws

# --- Backup -----------------------------------------------------------------
BACKUP_DIR=/opt/rastichat/backups
BACKUP_RETENTION_DAYS=14

# --- Monitoring ---------------------------------------------------------------
# Required in staging/production — /api/v1/health/monitoring/ (disk usage,
# backup freshness, scheduler heartbeat status) requires this exact value in
# an X-Monitoring-Token header, or a bare 401 with no detail otherwise.
# scripts/staging/status.sh and scripts/staging/load-baseline.mjs already
# send it from this same env file. Generate with scripts/generate-secrets.sh.
MONITORING_TOKEN=REPLACE_WITH_OUTPUT_OF_scripts_generate-secrets.sh
