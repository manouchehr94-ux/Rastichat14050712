# sourced by the other scripts: requires SANDBOX_DIR, SB (this directory) and R (repo root)
export DJANGO52_ISOLATED_STAGING=yes-this-is-an-isolated-staging-stack
export SMOKE_BACKEND_URL=https://chat-stg.example.test
export SMOKE_WS_URL=wss://chat-stg.example.test/ws
export SMOKE_OPERATOR_URL=https://operator-stg.example.test/admin
export SMOKE_PLATFORM_URL=https://platform-stg.example.test/platform
export SMOKE_WIDGET_URL=https://chat-stg.example.test/widget.js
export SMOKE_PROJECT_KEY=$(python3 -c "import json,sys;print(json.load(open(sys.argv[1]))['projectA'])" $SANDBOX_DIR/stg/keys.json)
export SMOKE_OPERATOR_EMAIL=agent-a1@example.test
export SMOKE_OPERATOR_PASSWORD=Stg-Only-Pass-123
export DJANGO52_ALLOWED_EMBED_ORIGIN=https://embed-allowed.example.test
export DJANGO52_FORBIDDEN_EMBED_ORIGIN=https://embed-forbidden.example.test
export DJANGO52_EXPECT_LEGACY_URL_OFF=1
export NO_PROXY='*' no_proxy='*'
export NODE_EXTRA_CA_CERTS=$SANDBOX_DIR/stg/ca.crt
export PW_CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
unset HTTPS_PROXY https_proxy HTTP_PROXY http_proxy ALL_PROXY all_proxy
export STG_BALANCER_PIDFILE=$SANDBOX_DIR/stg/logs/balancer.pid
export STG_DJ=$SB/dj.sh STG_LOGS=$SANDBOX_DIR/stg/logs
export NODE_PATH=$R/e2e/node_modules
export STG_INTEGRATION_FILE=$SANDBOX_DIR/stg/integration.json
