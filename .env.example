# Local development environment template.
#
# Copy to `.env` (or export these directly) for a plain `manage.py runserver`
# / `npm run dev` workflow outside Docker. The existing dev docker-compose.yml
# already sets sane defaults for its own containers and does not need this
# file. Never commit a real `.env` — only this `.env.example` template is
# tracked.
#
# See docs/runbooks/ENVIRONMENT_VARIABLES.md for the full reference of every
# variable, including the staging/production-only ones that are irrelevant
# here.

# --- Django -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=1
# Left unset in development: settings.py falls back to a fixed insecure
# development-only key. Staging/production MUST set a real one — see
# .env.staging.example / .env.production.example.
# DJANGO_SECRET_KEY=

# Left unset in development: settings.py defaults ALLOWED_HOSTS to ['*'].
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Postgres — SQLite is never used in this project) --------
DB_NAME=rastichat_db
DB_USER=rastichat
DB_PASSWORD=rastichat_secret
DB_HOST=localhost
DB_PORT=5432
# Alternative to the DB_* vars above: a single DATABASE_URL takes priority
# when set, e.g. postgres://rastichat:rastichat_secret@localhost:5432/rastichat_db
# DATABASE_URL=

# --- Redis (Channels/WebSocket layer) -----------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# --- Frontend build-time URLs (Next.js NEXT_PUBLIC_* are baked in at
# `next build` time, not read at runtime) --------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8080/ws
